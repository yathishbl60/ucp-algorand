{
  "name": "ucp-algorand",
  "version": "1.0.0",
  "description": "Production-grade UCP payment handler for Algorand — ALGO and ASA payments via the Universal Commerce Protocol",
  "type": "module",
  "main": "dist/server/main.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server/main.js",
    "dev": "tsx watch src/server/main.ts",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "quality": "npm run typecheck && npm run lint && npm run test -- --runInBand",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/request-context": "^6.0.1",
    "algosdk": "^3.2.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "nanoid": "^5.1.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
