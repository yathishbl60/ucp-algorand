# ─── Algorand Node ──────────────────────────────────────────────────────────
# Algonode public endpoints (no API key required for TestNet/MainNet)
ALGORAND_NETWORK=testnet
ALGORAND_ALGOD_URL=https://testnet-api.algonode.cloud
ALGORAND_ALGOD_TOKEN=
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
ALGORAND_INDEXER_TOKEN=

# ─── Merchant Identity ──────────────────────────────────────────────────────
# The Algorand address that will receive payments
ALGORAND_MERCHANT_ADDRESS=REPLACE_WITH_YOUR_58_CHAR_ALGORAND_ADDRESS

# Optional: Escrow smart contract application ID (deploy PaymentEscrow first)
# ALGORAND_ESCROW_APP_ID=

# ─── UCP Server ─────────────────────────────────────────────────────────────
UCP_BASE_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Minimum Algorand rounds before a payment is considered final
# 1 round ≈ 4 seconds (Algorand has immediate finality, 1 is safe)
ALGORAND_MIN_CONFIRMATIONS=1

# ─── Webhooks (Optional) ────────────────────────────────────────────────────
# Send checkout lifecycle events to your order management system.
# Set BOTH values together. If one is set without the other, server startup fails.
# WEBHOOK_URL=https://merchant.example.com/webhooks/ucp
# WEBHOOK_SECRET=replace_with_a_long_random_secret_min_16_chars

# ─── Store Branding (Optional) ──────────────────────────────────────────────
# Displayed in the UCP business profile to help buyer platforms show context.
# STORE_NAME=Acme Store
# STORE_DESCRIPTION=Premium digital goods and subscriptions
# STORE_SUPPORT_EMAIL=support@example.com
# STORE_LOGO_URL=https://cdn.example.com/logo.png

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * only in development)
CORS_ORIGINS=*
